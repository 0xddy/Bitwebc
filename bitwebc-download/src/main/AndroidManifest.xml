<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application>
        <provider
            android:name="cn.lmcw.bitwebc.download.BitwebcDownloadFileProvider"
            android:authorities="${applicationId}.bitwebc.download.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/bitwebc_download_paths" />
        </provider>
        <receiver
            android:name=".notification.DownloadNotificationReceiver"
            android:exported="false" />
    </application>
</manifest>
